# Servidor local
PORT=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:4177
PUBLIC_SITE_URL=https://cuarentamas.com

# Tiendanube (solo servidor; nunca exponer con el prefijo VITE_)
TIENDANUBE_APP_ID=
TIENDANUBE_APP_SECRET=
TIENDANUBE_REDIRECT_URI=
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_PRODUCT_ID=
TIENDANUBE_VARIANT_ID=
TIENDANUBE_STORE_FRONT_URL=
ENABLE_TIENDANUBE_CHECKOUT=false
ENABLE_TIENDANUBE_ADMIN_ROUTES=false

# Automatización del formulario en Make (solo servidor)
EXPERIENCE_WEBHOOK_URL=
EXPERIENCE_WEBHOOK_TOKEN=

# Cloudflare Turnstile (clave pública en Vite y clave secreta solo en servidor)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=experience_form
TURNSTILE_ALLOWED_HOSTNAMES=cuarentamas.com,www.cuarentamas.com

# Frontend (las variables VITE_* son públicas en el navegador)
VITE_ENABLE_MEMBRESIA=
VITE_META_PIXEL_ID=1343351624102596
